{
  "name": "ea-script-template",
  "version": "1.0.0",
  "description": "Professional starter template for building ExcalidrawAutomate scripts for Obsidian Excalidraw",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/**/*.ts\" \"scripts/**/*.ts\" \"examples/**/*.ts\"",
    "lint:fix": "eslint --no-error-on-unmatched-pattern \"src/**/*.ts\" \"scripts/**/*.ts\" \"examples/**/*.ts\" --fix",
    "format": "prettier --no-error-on-unmatched-pattern --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"examples/**/*.ts\" \"*.md\"",
    "format:check": "prettier --no-error-on-unmatched-pattern --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"examples/**/*.ts\" \"*.md\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "package": "npm run build && node scripts/package.mjs",
    "new-script": "tsx scripts/new-script.ts",
    "sync-refs": "node scripts/sync-refs.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@zsviczian/excalidraw": "^0.18.129",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "obsidian": "^1.13.1",
    "obsidian-excalidraw-plugin": "github:zsviczian/obsidian-excalidraw-plugin",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "obsidian",
    "excalidraw",
    "excalidraw-automate",
    "script-template"
  ],
  "author": "",
  "license": "MIT"
}
